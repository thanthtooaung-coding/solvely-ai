# Copy this file to .env and fill in your own key. Never commit .env.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
PORT=3000
GEMINI_TIMEOUT_MS=120000
# Optional: ElevenLabs voice for the whiteboard tutor (falls back to Gemini TTS on failure)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_MODEL_MY=eleven_v4
ELEVENLABS_LANGUAGES=en,my
# Live streaming: lesson voice starts in under a second, chat replies are spoken as they are written
ELEVENLABS_STREAM_MODEL=eleven_flash_v2_5
ELEVENLABS_STREAM_MODEL_MY=eleven_v4
ELEVENLABS_STREAM_LANGUAGES=en,my
